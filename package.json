{
  "name": "pi-agentworks",
  "version": "0.1.0",
  "description": "Role-aware interactive Pi agent teams orchestrated in Herdr panes with isolated Git worktrees.",
  "license": "MIT",
  "author": "Brett Poole",
  "homepage": "https://github.com/interwebworks/pi-agentworks#readme",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/interwebworks/pi-agentworks.git"
  },
  "bugs": {
    "url": "https://github.com/interwebworks/pi-agentworks/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "agents",
    "herdr",
    "worktrees"
  ],
  "files": [
    "src/",
    "role-packs/",
    "docs/",
    "PRODUCT_SPEC.md",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "audit:runtime": "npm audit --omit=dev",
    "quality": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run audit:runtime"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@earendil-works/pi-tui": "^0.83.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "typebox": "^1.1.38",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
